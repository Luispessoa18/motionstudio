# Ollama local (padrão)
MOTION_LLM=ollama
OLLAMA_URL=http://localhost:11434
MOTION_MODEL=qwen2.5:14b
VISION_MODEL=qwen2.5vl:7b

# Para usar 9router, troque MOTION_LLM e preencha a chave:
# MOTION_LLM=9router
# NINEROUTER_URL=http://localhost:20128/v1
# NINEROUTER_API_KEY=sk-...
# MOTION_MODEL=kr/claude-sonnet-4.5
# VISION_MODEL=kr/claude-sonnet-4.5
# MOTION_REASONING_EFFORT=high

# Narração (opcional). Também dá para preencher pela tela Configurações.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Fotos de banco (opcional, basta uma). Ícones vêm do Iconify e não precisam de chave.
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
